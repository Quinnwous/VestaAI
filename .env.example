# VestaAI — omgevingsvariabelen
#
# Kopieer dit bestand naar `.env.local` en vul de waarden aan. `.env.local`
# wordt nooit gecommit (zie .gitignore) en wijst in Quinns eigen setup naar de
# PRODUCTIEDATABASE — wees voorzichtig met scripts die schrijven.
#
# Controleer of de verplichte sleutels aanwezig zijn met: npm run env:check

# == verplicht ==
# Supabase-projectinstellingen (Database + Auth + Storage). Te vinden in het
# Supabase-dashboard onder Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
# Publieke anon-key — client-side veilig, RLS regelt de rest.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role-key — omzeilt RLS. Alleen server-side (lib/supabase.ts
# createServiceSupabaseClient, admin-acties). Nooit naar de client sturen.
SUPABASE_SERVICE_ROLE_KEY=
# Claude API-sleutel (Anthropic SDK leest deze zelf, geen expliciete
# process.env-referentie in de code). Voedt de contentsuite (lib/claude.ts),
# de AI USP-extractor, de documentenassistent en de huisstijl-extractie uit
# een logo/screenshot.
ANTHROPIC_API_KEY=
# Resend — verzendt transactionele e-mail (wachtwoord-reset, teamuitnodiging,
# feedback, pdf per mail). Zonder deze sleutel gooit lib/email.ts een fout
# zodra er daadwerkelijk gemaild wordt.
RESEND_API_KEY=

# == optioneel ==
# Gemini API-sleutel voor virtual staging (app/api/fotos/staging). Zonder
# deze sleutel faalt alleen die ene functie, de rest van de app werkt door.
GOOGLE_AI_API_KEY=
# BAG-sleutel (Kadaster) voor adres-autocomplete en het voorvullen van
# bouwjaar/oppervlakte in de intake (lib/bag.ts, app/api/bag*). Gratis te
# registreren. Zonder sleutel geeft de route een nette 503 en typt de
# makelaar zelf door.
KADASTER_API_KEY=
# Extra platform-admin-e-mailadressen naast de vaste waarde in lib/admin.ts,
# komma-gescheiden. Optioneel — er is altijd al minstens één vaste admin.
PLATFORM_ADMIN_EMAILS=
# Canonieke app-URL voor e-mails, sitemap en metadata (lib/appUrl.ts). Zonder
# waarde (of op een *.vercel.app-adres) valt de app terug op
# https://www.vestaai.nl.
NEXT_PUBLIC_APP_URL=
# Zet op 1 om tijdens lokaal ontwikkelen het daadwerkelijk versturen van
# feedback-mail over te slaan (app/(app)/feedback-actions.ts).
FEEDBACK_SKIP_SEND=
# Zet op true om `next build` te draaien met de bundle-analyzer
# (next.config, zie CLAUDE.md over kaartlagen en bundle-grootte).
ANALYZE=
# Poort waarop `next dev`/`next start` luistert. Standaard 3000.
PORT=

# == alleen scripts/DoD/e2e ==
# Niet nodig om de app zelf te draaien — alleen voor de onderstaande npm-
# scripts en de Playwright-suite, altijd tegen dezelfde productiedatabase.
# Poort voor scripts/dod-screens.mjs en scripts/generale-repetitie.mjs.
# Standaard 3000; ook gebruikt als fallback-poort door sommige scripts.
DOD_PORT=
# Inlog-e-mailadres voor npm run dod:screens / demo:repetitie. Standaard
# demo@vestaai.nl (het demo-kantoor met data); zet 'm op
# quinn.berkouwer@icloud.com voor de i4 Housing-kant.
DOD_EMAIL=
# Kantoorslug voor scripts/generale-repetitie.mjs (welk kantoor de repetitie
# doorloopt). Standaard 'demo'.
DEMO_KANTOOR=
# Wachtwoord van het demo-account (demo@vestaai.nl), nodig voor e2e-tests die
# écht via het formulier inloggen (e2e/demo.setup.ts) en voor
# scripts/backtest-waardering.mjs / scripts/meet-performance.mjs. Ontbreekt
# hij, dan slaan de bijbehorende e2e-tests zichzelf over.
DEMO_PASSWORD=
# Alternatieve, niet-publieke Supabase-URL voor e2e-scripts die met de
# service-role-key werken (valt terug op NEXT_PUBLIC_SUPABASE_URL).
SUPABASE_URL=
# Basis-URL voor de Playwright-suite zelf (playwright.config.ts). Zonder
# waarde start Playwright zelf een dev-server op poort 3000.
PLAYWRIGHT_BASE_URL=
# E-mailadres voor de generieke e2e-sessie (e2e/auth.setup.ts,
# primitives.spec.ts). Standaard demo@vestaai.nl.
E2E_TEST_EMAIL=
# Zet op 1 om de contentgeneratie-e2e-test aan te zetten (content.spec.ts).
# Kost echte Claude-API-credits (NL+EN, ~€0,08-0,16 per run) — niet standaard
# aanzetten.
E2E_GENERATE=
# Zet op 1 om lib/transactiesQuery.rpc.test.ts te draaien tegen de live
# database (vergelijkt elke RPC met een JS-referentieberekening). Zonder
# deze waarde wordt die test overgeslagen.
SUPABASE_TEST=
